# 配置: `sudo mkdir -p /etc/glowbe && sudo cp glowbe.env.example /etc/glowbe/glowbe.env` のあと編集。
# `glowbe-runtime.service` と `glowbe-web.service` の両方が読みます（必須）。

# リポジトリの絶対パス（clone 先に合わせる）
GLOWBE_ROOT=/path/to/Glowbe

# preview / systemd 上の Node がプロキシするランタイム
GLOWBE_RUNTIME_URL=http://127.0.0.1:8748
GLOWBE_PREVIEW_PORT=8090
# GLOWBE_ALLOWED_HOSTS=your-host.example.ts.net
