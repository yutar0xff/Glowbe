[Unit]
Description=Glowbe runtime (HTTP API, WebSocket, UDP frame output)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=main
Group=main
EnvironmentFile=/etc/glowbe/glowbe.env
# WorkingDirectory / ExecStart の先頭は絶対パス必須のため、GLOWBE_ROOT は bash 側で展開する
ExecStart=/bin/bash -c 'cd -- "$GLOWBE_ROOT" && exec "$GLOWBE_ROOT/runtime/target/release/glowbe-runtime" "$GLOWBE_ROOT/config.toml"'
Restart=on-failure
RestartSec=4

[Install]
WantedBy=multi-user.target
