# 配置: `sudo mkdir -p /etc/glowbe && sudo cp glowbe-web.env.example /etc/glowbe/web.env` のあと編集。
# unit 側は `EnvironmentFile=-/etc/glowbe/web.env`（`glowbe-web.service`）。上書きは `systemctl edit glowbe-web` でも可。
#
# ランタイムが別ホストのときのみ変更（同一マシンならこのまま）

GLOWBE_RUNTIME_URL=http://127.0.0.1:8748
GLOWBE_PREVIEW_PORT=8090
# GLOWBE_ALLOWED_HOSTS=your-host.tailabcdef.ts.net
