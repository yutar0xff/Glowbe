[Unit]
Description=Glowbe Studio (static UI + API proxy to runtime)
After=network-online.target glowbe-runtime.service
Wants=network-online.target

[Service]
Type=simple
User=main
Group=main
Environment=NODE_ENV=production
EnvironmentFile=/etc/glowbe/glowbe.env
ExecStart=/bin/bash -c 'exec "$GLOWBE_ROOT/deploy/systemd/glowbe-web-preview.sh"'
Restart=on-failure
RestartSec=4

[Install]
WantedBy=multi-user.target
